# ============================================================
# Binance Trading Dashboard — environment variables
# ============================================================
# NOTE: Binance API keys are NOT needed and NOT used.
# The system reads PUBLIC market data only (no trading permissions).

# Optional: Telegram alerts (get a bot token from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: custom config path
# DASHBOARD_CONFIG=config/settings.json

# Optional: log verbosity
# LOG_LEVEL=INFO
